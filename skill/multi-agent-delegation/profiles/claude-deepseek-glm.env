# Profile: claude-deepseek-glm
# Summary: 纯 Claude Code + 国内多模型（DeepSeek 轻量侦察/杂活 + 智谱 GLM/Kimi 主力写码 + 高配模型攻坚）
#
# 使用前准备：
# - 已安装 Claude Code (`claude`)；
# - 在 shell 环境中导出对应 API Key（绝不把明文 Key 写进本文件）：
#     export DEEPSEEK_API_KEY="sk-..."
#     export ZHIPU_API_KEY="..."   # 若 ~/.claude/settings.json 已默认配置智谱，可留空 CODER_* 变量
# - 可将任意角色的 BASE_URL 替换为 Kimi / MiniMax / 硅基流动 / 火山引擎等 Anthropic 兼容端点。

# --- 5 Universal Roles (format: <harness>:<model>) ---
DELEGATE_ROLE_SCOUT=claude:deepseek-chat
DELEGATE_ROLE_FAST=claude:deepseek-chat
DELEGATE_ROLE_CODER=claude:sonnet
DELEGATE_ROLE_HEAVY=claude:opus
DELEGATE_ROLE_ARCHITECT=claude:opus

# --- Per-Role Claude Anthropic-Compatible Endpoints (optional) ---
DELEGATE_ROLE_SCOUT_BASE_URL=https://api.deepseek.com/anthropic
DELEGATE_ROLE_SCOUT_API_KEY_ENV=DEEPSEEK_API_KEY

DELEGATE_ROLE_FAST_BASE_URL=https://api.deepseek.com/anthropic
DELEGATE_ROLE_FAST_API_KEY_ENV=DEEPSEEK_API_KEY

# 主力 coder 默认复用 ~/.claude/settings.json（如智谱 GLM Coding Plan），也可单独指定：
# DELEGATE_ROLE_CODER_BASE_URL=https://open.bigmodel.cn/api/anthropic
# DELEGATE_ROLE_CODER_API_KEY_ENV=ZHIPU_API_KEY

# --- Execution & Fallback Defaults ---
DELEGATE_DEFAULT_FALLBACK=fast
DELEGATE_DEFAULT_TEST_CMD=python3
DELEGATE_DEFAULT_EFFORT=high
DELEGATE_DEFAULT_MAX_BUDGET=1.00
DELEGATE_DEFAULT_TIMEOUT=300s
DELEGATE_SCRATCH_DIR=$HOME/work/agy-scratch

# Disable unused harnesses on this machine
DELEGATE_DISABLED_HARNESSES=agy,cursor
