# Multi-Agent Delegation Kit — User-Level Configuration
# Path: ~/.config/multi-agent-delegation/config.env
# Priority: CLI flags > Project config (.agents/delegation/config.env) > User config (this file) > Kit defaults
#
# Quick start: run `load_config.sh --list-profiles` and `load_config.sh --use-profile <name>`
# to apply a domestic multi-subscription preset (agy-cursor-zhipu / claude-deepseek-glm / agy-only).
#
# Notes:
# - Safe KEY=VALUE format only (no shell execution; comments start with #).
#   An inline comment needs whitespace before the #: `KEY=value  # comment`.
# - `none` or `0` turns a limit off, e.g. DELEGATE_DEFAULT_MAX_BUDGET=none.
# - Upgrading the skill via install.sh will NEVER overwrite this file.

# --- 5 Universal Role Bindings (format: <harness>:<model>, harnesses: agy | claude | cursor) ---
# DELEGATE_ROLE_SCOUT=agy:gemini-4-hydrogen-low
# DELEGATE_ROLE_FAST=agy:gemini-4-hydrogen-medium
# DELEGATE_ROLE_CODER=claude:sonnet
# DELEGATE_ROLE_HEAVY=agy:claude-sonnet-5-5-medium
# DELEGATE_ROLE_ARCHITECT=agy:claude-opus-5-5-medium

# --- Optional Per-Role Claude Endpoint Overrides (for DeepSeek / GLM / Kimi / MiniMax, etc.) ---
# Store ONLY the env var name in *_API_KEY_ENV, never plaintext secrets!
# DELEGATE_ROLE_SCOUT_BASE_URL=https://api.deepseek.com/anthropic
# DELEGATE_ROLE_SCOUT_API_KEY_ENV=DEEPSEEK_API_KEY
# DELEGATE_ROLE_FAST_BASE_URL=
# DELEGATE_ROLE_FAST_API_KEY_ENV=
# DELEGATE_ROLE_CODER_BASE_URL=
# DELEGATE_ROLE_CODER_API_KEY_ENV=
# DELEGATE_ROLE_HEAVY_BASE_URL=
# DELEGATE_ROLE_HEAVY_API_KEY_ENV=
# DELEGATE_ROLE_ARCHITECT_BASE_URL=
# DELEGATE_ROLE_ARCHITECT_API_KEY_ENV=

# --- Execution & Fallback Defaults ---
# DELEGATE_DEFAULT_FALLBACK=fast          # comma-separated chain is allowed, e.g. fast,scout
# DELEGATE_DEFAULT_TEST_CMD=python3
# DELEGATE_DEFAULT_EFFORT=high
# DELEGATE_DEFAULT_MAX_BUDGET=1.00        # none or 0 removes the cap
# DELEGATE_DEFAULT_TIMEOUT=300s
# DELEGATE_SCRATCH_DIR=$HOME/work/agy-scratch

# --- Preflight: fail fast on a broken network path instead of letting a CLI retry for minutes ---
# DELEGATE_PREFLIGHT_TIMEOUT=5            # seconds to wait for the endpoint; 0 disables the check
# DELEGATE_PROXY_ENSURE_CMD=              # optional command that brings a loopback proxy or tunnel back, e.g.
#                                         # ssh -fN -o ExitOnForwardFailure=yes -L 3129:127.0.0.1:3128 vps
# DELEGATE_HEARTBEAT_INTERVAL=30          # seconds between progress lines while a harness runs; 0 turns them off

# --- AGY guard hook (scripts/guard_subagent.py, installed by `install.sh --with-hooks`) ---
# DELEGATE_INHERIT_SUBAGENT=rewrite       # a subagent on the primary model: rewrite | deny | allow.
#                                         # deny also refuses every `self` worker whatever its Model; only
#                                         # read-only `research` subagents stay native, on flash / flash_lite
# DELEGATE_INHERIT_REWRITE_MODEL=flash    # native tier such a subagent is rewritten to: flash | flash_lite
# DELEGATE_AUTO_ALLOW_DELEGATE=0          # 1 = canonical run_delegate.sh commands skip prompts and the sandbox

# --- Disabled Harnesses or Roles/Presets (comma-separated) ---
# DELEGATE_DISABLED_HARNESSES=
# DELEGATE_DISABLED_PRESETS=

# --- Legacy Preset Model Overrides (optional, for --preset backward compatibility) ---
# DELEGATE_MODEL_HYDROGEN_LOW=gemini-4-hydrogen-low
# DELEGATE_MODEL_HYDROGEN=gemini-4-hydrogen-medium
# DELEGATE_MODEL_GLM=sonnet
# DELEGATE_MODEL_GLM_OPUS=opus
# DELEGATE_MODEL_SONNET_AGY=claude-sonnet-5-5-medium
# DELEGATE_MODEL_SONNET_CURSOR=claude-sonnet-5-5-medium
# DELEGATE_MODEL_OPUS_PLAN=claude-opus-5-5-medium
