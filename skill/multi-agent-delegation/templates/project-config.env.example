# Multi-Agent Delegation Kit — Project-Level Configuration
# Path: <project_root>/.agents/delegation/config.env
# Priority: CLI flags > Project config (this file) > User config > Kit defaults
#
# Notes:
# - Safe KEY=VALUE format only (parsed without shell eval for repo safety).
# - Override only project-specific settings here (e.g. test command, budget, role overrides).

# --- Project test & execution defaults ---
# DELEGATE_DEFAULT_TEST_CMD=pytest
# DELEGATE_DEFAULT_FALLBACK=fast
# DELEGATE_DEFAULT_EFFORT=high
# DELEGATE_DEFAULT_MAX_BUDGET=1.00
# DELEGATE_DEFAULT_TIMEOUT=300s

# --- Optional project-specific role override ---
# DELEGATE_ROLE_CODER=claude:sonnet
# DELEGATE_DISABLED_HARNESSES=
# DELEGATE_DISABLED_PRESETS=
